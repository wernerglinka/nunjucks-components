{
  "name": "search",
  "type": "partial",
  "abstract": true,
  "styles": ["search.css"],
  "scripts": ["search.js"],
  "fields": {
    "placeholder": {
      "widget": "text",
      "label": "Search placeholder",
      "default": "Search..."
    },
    "settings": {
      "maxResults": {
        "widget": "number",
        "label": "Max results",
        "default": 20
      },
      "minCharacters": {
        "widget": "number",
        "label": "Minimum characters",
        "default": 2
      },
      "showRelevanceScore": {
        "widget": "checkbox",
        "label": "Show relevance score",
        "default": true
      },
      "enableHighlighting": {
        "widget": "checkbox",
        "label": "Enable highlighting",
        "default": true
      }
    }
  },
  "validation": {
    "properties": {
      "title": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "placeholder": {
        "type": "string",
        "default": "Search..."
      },
      "settings.maxResults": {
        "type": "number",
        "default": 20
      },
      "settings.showRelevanceScore": {
        "type": "boolean",
        "default": true
      },
      "settings.enableHighlighting": {
        "type": "boolean",
        "default": true
      },
      "settings.minCharacters": {
        "type": "number",
        "default": 2
      }
    }
  }
}
