{
  "name": "calendar",
  "type": "section",
  "styles": ["calendar.css"],
  "scripts": ["calendar.js"],
  "requires": ["text", "commons", "button", "overlay"],
  "context": ["data.calendars"],
  "modules": {
    "providers": ["google-calendar.js"],
    "helpers": ["date-utils.js", "event-transformer.js"]
  },
  "validation": {
    "required": ["sectionType"],
    "properties": {
      "sectionType": {
        "type": "string",
        "const": "calendar"
      },
      "calendars": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Data source file name in lib/data/calendars/"
          },
          "apiKey": {
            "type": "string",
            "description": "Google Calendar API key, when the calendars are listed inline"
          },
          "calendars": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "text": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "prose": {
            "type": "string"
          }
        }
      }
    }
  },
  "fields": {
    "text": {
      "$use": "text"
    },
    "calendars": {
      "source": {
        "widget": "text",
        "label": "Data source (optional)",
        "default": ""
      },
      "apiKey": {
        "widget": "text",
        "label": "Google API key (optional)",
        "default": ""
      },
      "calendars": {
        "widget": "array",
        "label": "Calendars",
        "items": {
          "id": {
            "widget": "text",
            "label": "Calendar ID",
            "default": ""
          },
          "name": {
            "widget": "text",
            "label": "Display name",
            "default": ""
          },
          "category": {
            "widget": "text",
            "label": "Category (used for styling)",
            "default": ""
          }
        }
      }
    },
    "$extends": ["commons"]
  }
}
