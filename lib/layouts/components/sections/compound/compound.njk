{% from "components/_helpers/render-section.njk" import renderSection %}
{% from "components/_helpers/build-container-attributes.njk" import buildContainerAttributes %}

{#
  Reconstruct context so nested renderSection calls have access to all
  page-level data. Must stay in sync with the variable list extracted in
  components/_helpers/render-section.njk (same pattern as multi-tab).
#}
{% set compoundContext = {
  data: data,
  collections: collections,
  urlPath: urlPath,
  collection: collection,
  crumbs: crumbs
} %}

{# loop through all compound sections and render them #}
{% for section in section.compoundSections %}
  {# don't render section is disabled in frontmatter #}
  {% if not section.isDisabled %}

    {# section wrapper may be article, aside, section or div depending on section.containerTag setting #}
    <{{ section.containerTag }} class="content">

      {# section content #}
      {{ renderSection(section, compoundContext) }}

      {% set containerTag = section.containerTag %}
    </{{ containerTag }}>

  {% endif %}
{% else %}
  <p class="error-message" role="alert" aria-live="polite">
    <span class="sr-only">Notice: </span>
    There are no compound sections available
  </p>
{% endfor %}
